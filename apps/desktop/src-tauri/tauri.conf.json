{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IsctCompanion",
  "version": "1.1.5",
  "identifier": "app.isctcompanion",
  "build": {
    "beforeBuildCommand": "yarn workspace @isct/desktop build",
    "beforeDevCommand": "yarn workspace @isct/desktop dev",
    "devUrl": "http://localhost:4173",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "capabilities": ["main"]
    },
    "windows": []
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "14.0",
      "entitlements": "Entitlements.plist",
      "bundleVersion": "1.1.5"
    },
    "resources": [
      "../../../crates/isct-ocr/models/alphabet/README.md",
      "../../../crates/isct-ocr/models/alphabet/MIT-LICENSE",
      "../../../crates/isct-ocr/models/paddle/README.md",
      "../../../crates/isct-ocr/models/paddle/PADDLE-LICENSE",
      "../../../crates/isct-ocr/models/paddle/ONNX-RUNTIME-LICENSE",
      "../../../crates/isct-ocr/models/paddle/ONNX-THIRD-PARTY-NOTICES.txt",
      "../../../docs/legal/EULA.md",
      "../../../docs/legal/EULA.ja.md"
    ],
    "licenseFile": "../../../docs/legal/EULA.md",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBFRDJDQjIwM0I5NzdFQzgKUldUSWZwYzdJTXZTRHFzN2lVeDNEdWcvM2VVcUR0cUJrL1pDL2hJNmo2ODRzc0ltRWplbGdCclcK",
      "requireSignedVersion": true
    }
  }
}
