<?xml version="1.0" encoding="utf-8"?>
<!-- Course materials, past exams and exports opened by content URI.
     The system camera writes a Matrix card photo into photos/. -->
<paths>
    <files-path name="files" path="files/" />
    <files-path name="past-exams" path="core/exam-share/" />
    <cache-path name="exports" path="exports/" />
    <cache-path name="photos" path="photos/" />
    <!-- An update's APK, handed to the system installer. -->
    <external-files-path name="updates" path="updates/" />
</paths>
