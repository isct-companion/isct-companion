{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://campus-life.example/schema/academic-calendar.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "academicYear", "source", "quarters", "days"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "academicYear": { "type": "integer", "minimum": 2000, "maximum": 2200 },
    "source": { "$ref": "#/$defs/source" },
    "quarters": {
      "type": "object", "additionalProperties": false,
      "required": ["1Q", "2Q", "3Q", "4Q"],
      "properties": {
        "1Q": { "$ref": "#/$defs/range" }, "2Q": { "$ref": "#/$defs/range" },
        "3Q": { "$ref": "#/$defs/range" }, "4Q": { "$ref": "#/$defs/range" }
      }
    },
    "days": { "type": "array", "items": { "$ref": "#/$defs/day" } }
  },
  "$defs": {
    "source": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["title", "url"], "properties": { "title": { "type": "string", "minLength": 1 }, "url": { "type": "string", "format": "uri", "pattern": "^https://" } } } },
    "range": { "type": "object", "additionalProperties": false, "required": ["start", "end"], "properties": { "start": { "$ref": "#/$defs/date" }, "end": { "$ref": "#/$defs/date" } } },
    "date": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "label": { "type": "object", "additionalProperties": false, "required": ["ja"], "properties": { "ja": { "type": "string", "minLength": 1 }, "en": { "type": "string", "minLength": 1 } } },
    "day": { "type": "object", "additionalProperties": false, "required": ["date", "type", "label"], "properties": { "date": { "$ref": "#/$defs/date" }, "type": { "enum": ["holiday", "no-class", "replacement"] }, "replacementDay": { "type": "integer", "minimum": 1, "maximum": 7 }, "label": { "$ref": "#/$defs/label" } }, "allOf": [{ "if": { "properties": { "type": { "const": "replacement" } }, "required": ["type"] }, "then": { "required": ["replacementDay"] }, "else": { "not": { "required": ["replacementDay"] } } }] }
  }
}
