# Public parser fixtures retain captured HTML whitespace and pinned byte hashes.
crates/app-core/tests/fixtures/kyomu/*.html text eol=lf whitespace=-blank-at-eol,-blank-at-eof
crates/app-core/tests/fixtures/subscriptions/** text eol=lf
.project/events.jsonl merge=union
# Kyocera's PPD may be redistributed only unaltered: keep it byte-for-byte.
crates/adpt-printer/assets/*.PPD -text
# Built by `yarn markdown-viewer` and bundled by the Android and iOS apps.
resources/markdown-viewer/* text eol=lf linguist-generated=true
# Compiled in byte for byte (include_bytes!): a line-ending checkout would
# break the PDFs' cross-reference offsets.
*.pdf binary
