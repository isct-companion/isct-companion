{
  "name": "isct-companion",
  "private": true,
  "version": "1.0.0-rc.1",
  "type": "module",
  "scripts": {
    "dev": "yarn workspace @isct/desktop dev",
    "build": "yarn workspace @isct/desktop build",
    "preview": "yarn workspace @isct/desktop preview",
    "tauri": "node scripts/desktop/tauri.mjs",
    "desktop:dev": "node scripts/desktop/tauri.mjs dev",
    "desktop:build": "node scripts/desktop/tauri.mjs build",
    "test": "yarn workspace @isct/desktop test && vitest run scripts",
    "test:watch": "yarn workspace @isct/desktop test:watch",
    "format": "yarn workspace @isct/desktop format",
    "icons:desktop": "node scripts/desktop/generate-desktop-icons.mjs",
    "core:types": "cargo run -p isct-core --features ts --example export-types && prettier --write apps/desktop/src/generated/persistence.ts",
    "backend:test": "cargo test --workspace --locked",
    "backend:check": "cargo check --workspace --locked"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.2",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "yaml": "^2"
  },
  "resolutions": {
    "katex": "^0.19.0"
  },
  "packageManager": "yarn@4.18.1",
  "workspaces": [
    "apps/desktop"
  ]
}
