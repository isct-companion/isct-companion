{
  "color": {
    "$type": "color",
    "$description": "Dark theme; same names as the light theme.",
    "bg": { "$value": "#141515" },
    "surface": { "$value": "#1d1e1e" },
    "surface-2": { "$value": "#232525" },
    "surface-3": { "$value": "#2b2d2d" },
    "line": { "$value": "#2f3131" },
    "line-strong": { "$value": "#3d4040" },
    "ink": { "$value": "#ececea" },
    "muted": { "$value": "#9a9c98" },
    "accent": { "$value": "#6f95f0" },
    "accent-ink": { "$value": "#0d1424" },
    "accent-soft": { "$value": "#23304d" },
    "danger": { "$value": "#e2685a" },
    "danger-soft": { "$value": "#3a2320" },
    "warn": { "$value": "#e0ad4a" },
    "warn-soft": { "$value": "#3a2f16" },
    "ok": { "$value": "#6fc48b" },
    "ok-soft": { "$value": "#1e3526" }
  },
  "shadow": {
    "$type": "shadow",
    "default": {
      "$value": [
        { "color": "#00000040", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" },
        { "color": "#00000050", "offsetX": "0px", "offsetY": "8px", "blur": "24px", "spread": "0px" }
      ]
    }
  }
}
