{
  "radius": {
    "$type": "dimension",
    "$description": "Corner radius by role. Platforms override the values (platforms/mobile.json), never the names.",
    "chip": { "$value": "6px", "$description": "Deadline chip, timetable block" },
    "control": { "$value": "8px", "$description": "Buttons, inputs, segmented controls" },
    "surface": { "$value": "10px", "$description": "Rows, cards, emphasised rows" },
    "panel": { "$value": "16px", "$description": "Reading pane, sheets" }
  },
  "font": {
    "$type": "fontFamily",
    "family": {
      "sans": {
        "$value": ["Inter", "-apple-system", "BlinkMacSystemFont", "Hiragino Sans", "Yu Gothic UI", "system-ui", "sans-serif"],
        "$description": "Desktop only; phones use the system font for native Japanese rendering and dynamic sizes"
      }
    }
  },
  "accent-scale": {
    "$type": "color",
    "$description": "Ten-step campus blue for UI frameworks that want a tonal scale (Mantine).",
    "0": { "$value": "#eef3ff" },
    "1": { "$value": "#dce7ff" },
    "2": { "$value": "#b8cdff" },
    "3": { "$value": "#8faeff" },
    "4": { "$value": "#6b94f8" },
    "5": { "$value": "#527ff0" },
    "6": { "$value": "#416fe5" },
    "7": { "$value": "#315fd0" },
    "8": { "$value": "#2853bb" },
    "9": { "$value": "#21479f" }
  }
}
