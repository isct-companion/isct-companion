{
  "radius": {
    "$type": "dimension",
    "$description": "Corner radius by role. Platforms override the values (platforms/mobile.json), never the names.",
    "course-marker": {
      "$value": "3px",
      "$description": "Corner radius of the 10-unit square that marks a course in a list, and of its loading placeholder."
    },
    "chip": {
      "$value": "6px",
      "$description": "Chips and tags"
    },
    "block": {
      "$value": "6px",
      "$description": "Timetable block"
    },
    "column": {
      "$value": "10px",
      "$description": "Timetable day column"
    },
    "control": {
      "$value": "8px",
      "$description": "Buttons, inputs, segmented controls"
    },
    "surface": {
      "$value": "12px",
      "$description": "Rows, cards, emphasised rows"
    },
    "panel": {
      "$value": "14px",
      "$description": "Sheets, dialogs and the content plane under the window chrome"
    }
  },
  "font": {
    "$type": "fontFamily",
    "family": {
      "sans": {
        "$value": [
          "Inter",
          "-apple-system",
          "BlinkMacSystemFont",
          "Hiragino Sans",
          "Yu Gothic UI",
          "system-ui",
          "sans-serif"
        ],
        "$description": "Desktop only; phones use the system font for native Japanese rendering and dynamic sizes"
      }
    }
  },
  "workspace": {
    "$type": "dimension",
    "$description": "Desktop workspace chrome: stable headers, inset controls and comfortable split targets.",
    "bar-height": {
      "$value": "42px"
    },
    "control-height": {
      "$value": "30px"
    },
    "gutter": {
      "$value": "{space.6}"
    },
    "splitter-width": {
      "$value": "20px"
    }
  },
  "space": {
    "$type": "dimension",
    "$description": "Spacing scale by step. Platforms may override a step's value in platforms/, never its name. Prefer a role (gutter, row-x, row-y, row-gap, card) when the value plays that role.",
    "1": {
      "$value": "2px",
      "$description": "Tailwind 0.5"
    },
    "2": {
      "$value": "4px",
      "$description": "Tailwind 1"
    },
    "3": {
      "$value": "6px",
      "$description": "Tailwind 1.5"
    },
    "4": {
      "$value": "8px",
      "$description": "Tailwind 2"
    },
    "5": {
      "$value": "10px",
      "$description": "Tailwind 2.5"
    },
    "6": {
      "$value": "12px",
      "$description": "Tailwind 3"
    },
    "7": {
      "$value": "14px",
      "$description": "Tailwind 3.5"
    },
    "8": {
      "$value": "16px",
      "$description": "Tailwind 4"
    },
    "9": {
      "$value": "20px",
      "$description": "Tailwind 5"
    },
    "10": {
      "$value": "24px",
      "$description": "Tailwind 6"
    },
    "11": {
      "$value": "32px",
      "$description": "Tailwind 8"
    },
    "gutter": {
      "$value": "{space.9}",
      "$description": "Page side margin"
    },
    "row-x": {
      "$value": "{space.8}",
      "$description": "List row, horizontal padding"
    },
    "row-y": {
      "$value": "{space.5}",
      "$description": "List row, vertical padding"
    },
    "row-gap": {
      "$value": "{space.6}",
      "$description": "Between rows and between a row's leading mark and its text"
    },
    "card": {
      "$value": "18px",
      "$description": "Card padding"
    }
  },
  "type": {
    "$description": "Desktop type scale by role; phones map the same roles to system text styles (Theme.swift, Theme.kt) so Dynamic Type and font scale apply.",
    "display": {
      "size": {
        "$type": "dimension",
        "$value": "40px"
      },
      "weight": {
        "$type": "fontWeight",
        "$value": 700
      },
      "$description": "Hero figures"
    },
    "title": {
      "size": {
        "$type": "dimension",
        "$value": "19px"
      },
      "weight": {
        "$type": "fontWeight",
        "$value": 700
      },
      "$description": "Page title"
    },
    "section": {
      "size": {
        "$type": "dimension",
        "$value": "12px"
      },
      "weight": {
        "$type": "fontWeight",
        "$value": 600
      },
      "$description": "Section header, muted"
    },
    "row": {
      "size": {
        "$type": "dimension",
        "$value": "14px"
      },
      "weight": {
        "$type": "fontWeight",
        "$value": 500
      },
      "$description": "Row title"
    },
    "note": {
      "size": {
        "$type": "dimension",
        "$value": "12px"
      },
      "weight": {
        "$type": "fontWeight",
        "$value": 400
      },
      "$description": "Secondary text, captions"
    },
    "block": {
      "size": {
        "$type": "dimension",
        "$value": "11px"
      },
      "weight": {
        "$type": "fontWeight",
        "$value": 600
      },
      "$description": "Timetable block text and tags"
    },
    "tick": {
      "size": {
        "$type": "dimension",
        "$value": "10px"
      },
      "weight": {
        "$type": "fontWeight",
        "$value": 400
      },
      "$description": "Time ticks beside the grid"
    }
  }
}
